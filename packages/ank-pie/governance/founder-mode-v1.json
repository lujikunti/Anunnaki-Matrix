    "A_BUILDER_MUST_NOT_BE_ITS_OWN_FINAL_VERIFIER_FOR_MATERIAL_WORK",
    "DONE_REQUIRES_EVIDENCE_NOT_PROGRESS_PERCENTAGES",
    "RELEASED_IS_A_STATE_TRANSITION_INTO_HOMEOSTASIS_NOT_THE_END_OF_THE_MISSION",
