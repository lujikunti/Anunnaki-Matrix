    "OBSERVE",
    "UNDERSTAND",
    "PROPOSE",
    "AGREE",
    "TAKE_OWNERSHIP",
    "BUILD",
    "RED_TEAM",
    "VERIFY",
    "RELEASE",
    "HOMEOSTASIS"
  ],
  "founder_rule": "THE_FOUNDER_IS_NOT_COMPANY_MIDDLEWARE",
  "principles": [
    "PIE_MAY_OBSERVE_WITHOUT_A_FOUNDER_PROMPT",
    "PIE_MUST_SEPARATE_FACTS_ASSUMPTIONS_INFERENCES_AND_PROPOSALS",
    "PIE_MUST_PROPOSE_BEFORE_ADOPTING_A_NEW_MISSION",
    "FOUNDER_ACCEPTANCE_CREATES_A_MISSION_CHARTER_NOT_NEW_RUNTIME_AUTHORITY",
