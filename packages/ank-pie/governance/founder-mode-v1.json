  "status": "CONTROLLED_PILOT",
  "purpose": "Allow PIE to observe active ANK products, infer likely founder intent, propose a better course, adopt an agreed mission charter, execute within existing authority, independently verify completion, and maintain post-release homeostasis while escalating only genuine founder decisions.",
  "canonical_loop": [
    "OBSERVE",
    "UNDERSTAND",
    "PROPOSE",
    "AGREE",
    "TAKE_OWNERSHIP",
    "BUILD",
    "RED_TEAM",
    "VERIFY",
    "RELEASE",
    "HOMEOSTASIS"
  ],
  "founder_rule": "THE_FOUNDER_IS_NOT_COMPANY_MIDDLEWARE",
  "principles": [
    "PIE_MAY_OBSERVE_WITHOUT_A_FOUNDER_PROMPT",
    "EVERY_ACTIVE_PROJECT_HAS_A_DURABLE_PROJECT_TWIN",
    "PIE_MUST_SEPARATE_FACTS_ASSUMPTIONS_INFERENCES_AND_PROPOSALS",
