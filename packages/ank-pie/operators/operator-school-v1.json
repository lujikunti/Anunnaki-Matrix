{
  "schema_version": "1.0.0",
  "policy_id": "ANK_OPERATOR_SCHOOL_V1",
  "status": "CANONICAL",
  "product_language": {
    "canonical_term": "ANK Operator",
    "legacy_interop_term": "Twin",
    "rule": "Use Operator in ANK, MN and GC product language. Legacy Twin terminology may remain only inside federation compatibility contracts until migrated safely."
  },
  "purpose": "Train governed AI workers against explicit job capability baselines before they may perform bounded work for ANK, MN or GC.",
  "pipeline": [
    "DIAGNOSE",
    "LEARN",
    "SIMULATE",
    "PRACTISE",
    "RED_TEAM",
    "ASSESS",
    "REMEDIATE",
    "REASSESS",
    "OPERATOR_PASSPORT",
    "RECALIBRATE"
  ],
  "readiness_states": [
    "APPRENTICE",
    "SUPERVISED_READY",
    "CALIBRATED",
    "RECALIBRATION_REQUIRED"
  ],
  "autonomy_classes": {
    "EXECUTE": "May perform reversible internal work within explicit capabilities and audit controls.",
    "SUPERVISED_EXECUTE": "May perform bounded work, but a human or higher-assurance control must review the consequential output before reliance.",
    "HUMAN_GATE": "May prepare, analyse or recommend, but cannot complete the consequential act."
  },
  "universal_human_gates": [
    "external_message",
    "public_publication",
    "production_release",
    "privilege_change",
    "secret_rotation",
    "billing_change",
    "pricing_change",
    "contract_execution",
    "destructive_data_change",
    "material_financial_commitment"
  ],
  "universal_forbidden_actions": [
    "self_expand_permissions",
    "disable_audit",
    "delete_audit_history",
    "bypass_human_gate",
    "store_secret_in_client",
    "impersonate_human",
    "fabricate_customer_or_evidence",
    "scrape_personal_contact_data",
    "unsolicited_bulk_message",
    "expose_cross_tenant_data",
    "claim_professional_licence_or_authority"
  ],
  "passport_required": [
    "passport_ref",
    "operator_id",
    "role_id",
    "product_scope",
    "capability_scope",
    "readiness_state",
    "autonomy_class",
    "evidence_summary",
    "red_team_summary",
    "corpus_version",
    "issued_at",
    "expires_at",
    "receipt_ref"
  ],
  "graduation_rules": [
    "No operator may graduate on self-asserted competence.",
    "High-consequence red-team failures block SUPERVISED_READY.",
    "Evidence must include at least one unseen simulation and one adversarial test.",
    "A passport grants bounded computational capability only, never human professional authority.",
    "Material scope or policy change triggers recalibration."
  ],
