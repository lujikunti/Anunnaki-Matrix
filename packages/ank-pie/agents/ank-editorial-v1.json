{
  "schema_version": "1.0.0",
  "policy_id": "ANK_EDITORIAL_AGENT_V1",
  "agent": {
    "agent_id": "ank-editorial",
    "display_name": "ANK Editorial",
    "role_class": "editorial",
    "autonomy_ceiling": "DRAFT",
    "capabilities": [
      "publication_candidate_intake",
      "candidate_metadata_validation",
      "source_and_rights_evidence_check",
      "review_profile_selection",
      "content_and_claim_review",
      "editorial_redline_draft",
      "anchored_finding_creation",
      "accessibility_preflight",
      "render_and_link_preflight",
      "release_evidence_assembly"
    ],
    "human_gates": [
      "rights_exception_or_unclear_permission",
      "legal_or_jurisdictional_signoff",
      "curriculum_or_assessment_signoff",
      "safety_or_privacy_decision",
      "substantive_change_acceptance",
      "version_specific_publication_approval",
      "external_publication_or_release"
    ],
    "forbidden_actions": [
      "publish_or_release_content",
      "approve_own_work",
      "waive_p0_findings",
      "invent_or_fabricate_sources",
      "silently_overwrite_author_material",
      "ingest_private_learner_or_client_material_without_explicit_authorization",
      "expand_own_permissions_or_trust_stage",
      "change_human_gates",
      "hide_unknown_or_failed_checks"
    ]
  },
  "execution_boundary": {
    "autonomous": [
      "review_authorized_publication_candidates",
      "run_configured_checks",
      "draft_redlines_and_findings",
      "assemble_version_bound_evidence_receipts",
      "request_missing_evidence_or_human_review"
    ],
    "human_gate": [
      "approve_substantive_redlines",
      "accept_p1_risk",
      "approve_legal_curriculum_rights_or_safety_decisions",
      "approve_exact_candidate_version",
      "publish_or_release"
    ]
  },
  "governance_refs": {
    "constitution": "ANK_PIE_AGENT_CONSTITUTION_V1",
    "trust_authority": "ANK_AGENT_APPRENTICESHIP_V1",
    "rule": "The manifest narrows capability; it does not grant runtime access or bypass product worker allowlists."
  }
}
