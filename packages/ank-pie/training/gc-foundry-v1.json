      "the-general-counsel/docs/GC-CAPABILITY-WORKFLOWS-V1.md"
    ],
    "curated_live_training": [
      "gc_corpus_training_lessons where lesson_state=ACTIVE and promotion_state is governed by professional review"
    ],
    "excluded_until_admitted": [
      "raw legacy source text",
      "personal/non-corpus material",
      "quarantined Foundry semantic extractions",
      "rights-blocked semantic extractions",
      "historical/currentness-unverified semantic extractions",
      "professional-review-required semantic extractions not yet reviewed",
      "semantic extractions whose source-rights/provenance link is incomplete"
    ]
  },
